{
  "manifest_version": 3,
  "name": "Kv Browser Bridge",
  "version": "0.2.13",
  "author": "Kv Browser Bridge contributors",
  "key": "",
  "description": "A local Chrome bridge for MCP clients. Control the current user's Chrome through Native Messaging.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "nativeMessaging", "debugger"],
  "optional_permissions": ["bookmarks", "downloads", "management"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-script.js"],
      "css": ["element-picker.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Kv Browser Bridge"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
