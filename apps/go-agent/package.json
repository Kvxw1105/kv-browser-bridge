{
  "name": "@kv-browser-bridge/go-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GO Agent: drive ChatGPT/DeepSeek web chat to a user-defined checkpoint (nudge loop + progress-summary protocol + pluggable decision engine).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./decision": {
      "types": "./dist/decision.d.ts",
      "import": "./dist/decision.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./file-storage": {
      "types": "./dist/file-storage.d.ts",
      "import": "./dist/file-storage.js"
    },
    "./ledger": {
      "types": "./dist/ledger.d.ts",
      "import": "./dist/ledger.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  }
}
