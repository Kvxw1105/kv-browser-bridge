{
  "name": "@kv-browser-bridge/codex-mcp-server",
  "version": "0.3.0",
  "private": true,
  "description": "Standalone stdio MCP servers for the local Chrome Bridge and Computer Use runtime.",
  "type": "module",
  "bin": {
    "kv-browser-bridge-mcp": "./dist/guarded-server.js",
    "kv-computer-use-mcp": "./dist/computer-server.js",
    "kv-computer-use-doctor": "./dist/computer-doctor.js",
    "kv-computer-use-status": "./dist/computer-status.js",
    "kv-computer-use-codex": "./dist/codex-install.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "tsx src/guarded-server.ts",
    "dev:computer": "tsx src/computer-server.ts",
    "doctor:computer": "node dist/computer-doctor.js --json",
    "status:computer": "node dist/computer-status.js --json",
    "codex:status": "node dist/codex-install.js status",
    "codex:install": "node dist/codex-install.js install",
    "codex:uninstall": "node dist/codex-install.js uninstall"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  }
}
